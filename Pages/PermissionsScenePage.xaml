<Page
    x:Class="WPF_CheckBox.Pages.PermissionsScenePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="权限选择"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel
            MaxWidth="700"
            Margin="20"
            HorizontalAlignment="Left">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="用户权限管理" />

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                        <Image Width="50" Height="50">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#3F51B5">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry
                                                        Center="25,25"
                                                        RadiusX="25"
                                                        RadiusY="25" />
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="White">
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry>M25,12.5A12.5,12.5 0 0,0 12.5,25A12.5,12.5 0 0,0 25,37.5A12.5,12.5 0 0,0 37.5,25A12.5,12.5 0 0,0 25,12.5M25,10.5A14.5,14.5 0 0,1 39.5,25A14.5,14.5 0 0,1 25,39.5A14.5,14.5 0 0,1 10.5,25A14.5,14.5 0 0,1 25,10.5M25,20A5,5 0 0,0 20,25A5,5 0 0,0 25,30A5,5 0 0,0 30,25A5,5 0 0,0 25,20Z</PathGeometry>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Text="管理员" />
                            <TextBlock Foreground="#666" Text="用户组：系统管理员" />
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Header="管理员权限">
                        <StackPanel>
                            <CheckBox
                                x:Name="systemSettingsPermission"
                                Content="系统设置访问权限"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="userManagementPermission"
                                Content="用户管理权限"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="dataBackupPermission"
                                Content="数据备份权限"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="logAccessPermission"
                                Content="系统日志访问权限"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="auditPermission"
                                Content="审核权限"
                                IsChecked="True" />
                        </StackPanel>
                    </GroupBox>

                    <Button
                        Margin="0,10,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Right"
                        Click="SaveAdminPermissions_Click"
                        Content="保存管理员权限" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="批量用户权限设置" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  用户列表  -->
                        <Border
                            Grid.Column="0"
                            BorderBrush="#ddd"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock
                                    Padding="10,5"
                                    Background="#f0f0f0"
                                    Text="用户列表" />
                                <StackPanel Margin="10">
                                    <CheckBox
                                        x:Name="user1"
                                        Content="用户1"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="user2"
                                        Content="用户2"
                                        IsChecked="True" />
                                    <CheckBox x:Name="user3" Content="用户3" />
                                    <CheckBox x:Name="user4" Content="用户4" />
                                    <CheckBox x:Name="user5" Content="用户5" />
                                    <CheckBox
                                        x:Name="selectAllUsers"
                                        Checked="SelectAllUsers_CheckChanged"
                                        Content="全选"
                                        Indeterminate="SelectAllUsers_CheckChanged"
                                        IsThreeState="True"
                                        Unchecked="SelectAllUsers_CheckChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!--  箭头  -->
                        <TextBlock
                            Grid.Column="1"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Text="→" />

                        <!--  权限设置  -->
                        <Border
                            Grid.Column="2"
                            BorderBrush="#ddd"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock
                                    Padding="10,5"
                                    Background="#f0f0f0"
                                    Text="权限设置" />
                                <StackPanel Margin="10">
                                    <CheckBox
                                        x:Name="viewDocumentsPermission"
                                        Content="查看文档"
                                        IsChecked="True" />
                                    <CheckBox x:Name="editDocumentsPermission" Content="编辑文档" />
                                    <CheckBox x:Name="deleteDocumentsPermission" Content="删除文档" />
                                    <CheckBox x:Name="shareDocumentsPermission" Content="共享文档" />
                                    <CheckBox
                                        x:Name="addCommentsPermission"
                                        Content="添加评论"
                                        IsChecked="True" />
                                    <Button
                                        Margin="0,10,0,0"
                                        Click="ApplyPermissions_Click"
                                        Content="应用权限设置" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="预设权限模板" />

                    <ComboBox
                        x:Name="permissionTemplateComboBox"
                        Margin="0,0,0,15"
                        SelectedIndex="0"
                        SelectionChanged="PermissionTemplate_SelectionChanged">
                        <ComboBoxItem Content="选择预设模板..." />
                        <ComboBoxItem Content="只读权限" />
                        <ComboBoxItem Content="标准用户权限" />
                        <ComboBoxItem Content="高级用户权限" />
                        <ComboBoxItem Content="完全权限" />
                    </ComboBox>

                    <GroupBox Header="权限明细">
                        <StackPanel x:Name="permissionDetailsPanel">
                            <TextBlock
                                Margin="0,5"
                                Foreground="#666"
                                Text="请选择一个权限模板查看详情" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 