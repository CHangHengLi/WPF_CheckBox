<Page x:Class="WPF_CheckBox.Pages.PermissionsScenePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_CheckBox.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="权限选择">

    <ScrollViewer>
        <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
            <TextBlock Text="用户权限管理" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Image Width="50" Height="50">
                            <Image.Source>
                                <DrawingImage>
                                    <DrawingImage.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#3F51B5">
                                                <GeometryDrawing.Geometry>
                                                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing Brush="White">
                                                <GeometryDrawing.Geometry>
                                                    <PathGeometry>M25,12.5A12.5,12.5 0 0,0 12.5,25A12.5,12.5 0 0,0 25,37.5A12.5,12.5 0 0,0 37.5,25A12.5,12.5 0 0,0 25,12.5M25,10.5A14.5,14.5 0 0,1 39.5,25A14.5,14.5 0 0,1 25,39.5A14.5,14.5 0 0,1 10.5,25A14.5,14.5 0 0,1 25,10.5M25,20A5,5 0 0,0 20,25A5,5 0 0,0 25,30A5,5 0 0,0 30,25A5,5 0 0,0 25,20Z</PathGeometry>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingImage.Drawing>
                                </DrawingImage>
                            </Image.Source>
                        </Image>
                        <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="管理员" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="用户组：系统管理员" Foreground="#666"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <GroupBox Header="管理员权限">
                        <StackPanel>
                            <CheckBox Content="系统设置访问权限" IsChecked="True" x:Name="systemSettingsPermission"/>
                            <CheckBox Content="用户管理权限" IsChecked="True" x:Name="userManagementPermission"/>
                            <CheckBox Content="数据备份权限" IsChecked="True" x:Name="dataBackupPermission"/>
                            <CheckBox Content="系统日志访问权限" IsChecked="True" x:Name="logAccessPermission"/>
                            <CheckBox Content="审核权限" IsChecked="True" x:Name="auditPermission"/>
                        </StackPanel>
                    </GroupBox>
                    
                    <Button Content="保存管理员权限" 
                            HorizontalAlignment="Right" 
                            Margin="0,10,0,0"
                            Padding="10,5"
                            Click="SaveAdminPermissions_Click"/>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="批量用户权限设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 用户列表 -->
                        <Border Grid.Column="0" BorderBrush="#ddd" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="用户列表" Background="#f0f0f0" Padding="10,5"/>
                                <StackPanel Margin="10">
                                    <CheckBox Content="用户1" IsChecked="True" x:Name="user1"/>
                                    <CheckBox Content="用户2" IsChecked="True" x:Name="user2"/>
                                    <CheckBox Content="用户3" x:Name="user3"/>
                                    <CheckBox Content="用户4" x:Name="user4"/>
                                    <CheckBox Content="用户5" x:Name="user5"/>
                                    <CheckBox Content="全选" x:Name="selectAllUsers" 
                                            IsThreeState="True" 
                                            Checked="SelectAllUsers_CheckChanged" 
                                            Unchecked="SelectAllUsers_CheckChanged"
                                            Indeterminate="SelectAllUsers_CheckChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- 箭头 -->
                        <TextBlock Grid.Column="1" Text="→" FontSize="24" Margin="10,0" VerticalAlignment="Center"/>
                        
                        <!-- 权限设置 -->
                        <Border Grid.Column="2" BorderBrush="#ddd" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="权限设置" Background="#f0f0f0" Padding="10,5"/>
                                <StackPanel Margin="10">
                                    <CheckBox Content="查看文档" x:Name="viewDocumentsPermission" IsChecked="True"/>
                                    <CheckBox Content="编辑文档" x:Name="editDocumentsPermission"/>
                                    <CheckBox Content="删除文档" x:Name="deleteDocumentsPermission"/>
                                    <CheckBox Content="共享文档" x:Name="shareDocumentsPermission"/>
                                    <CheckBox Content="添加评论" x:Name="addCommentsPermission" IsChecked="True"/>
                                    <Button Content="应用权限设置" 
                                          Margin="0,10,0,0"
                                          Click="ApplyPermissions_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="预设权限模板" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <ComboBox x:Name="permissionTemplateComboBox" 
                            SelectedIndex="0"
                            SelectionChanged="PermissionTemplate_SelectionChanged"
                            Margin="0,0,0,15">
                        <ComboBoxItem Content="选择预设模板..."/>
                        <ComboBoxItem Content="只读权限"/>
                        <ComboBoxItem Content="标准用户权限"/>
                        <ComboBoxItem Content="高级用户权限"/>
                        <ComboBoxItem Content="完全权限"/>
                    </ComboBox>
                    
                    <GroupBox Header="权限明细">
                        <StackPanel x:Name="permissionDetailsPanel">
                            <TextBlock Text="请选择一个权限模板查看详情" Foreground="#666" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 