<Page x:Class="WPF_CheckBox.Pages.CustomContentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_CheckBox.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="自定义内容">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="CheckBox自定义内容" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. 基本文本内容" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        除了简单的字符串外，Content属性还可以设置复杂的内容。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5">
                            <TextBlock Text="使用TextBlock作为内容" TextWrapping="Wrap"/>
                        </CheckBox>
                        
                        <CheckBox Margin="0,10,0,5">
                            <TextBlock>
                                <Run Text="带" FontWeight="Bold"/>
                                <Run Text="格式化" Foreground="Blue"/>
                                <Run Text="的文本" FontStyle="Italic"/>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. 内嵌布局和控件" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        CheckBox的内容可以包含复杂的布局和多个控件。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="16" Height="16" Fill="Red" Margin="0,0,5,0"/>
                                <TextBlock Text="带图形的选项"/>
                            </StackPanel>
                        </CheckBox>
                        
                        <CheckBox Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="标题：" FontWeight="Bold" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="带网格布局的复选框"/>
                                <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" 
                                           Text="可以包含多行内容和更复杂的布局" 
                                           Foreground="Gray"
                                           FontSize="11"
                                           Margin="0,3,0,0"/>
                            </Grid>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="3. 带图像的复选框" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        在CheckBox中使用图像和图标。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#e1f5fe" BorderBrush="#81d4fa" BorderThickness="1" Padding="3" Margin="0,0,8,0">
                                    <Path Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z" 
                                          Fill="#0288d1" 
                                          Stretch="Uniform" 
                                          Width="16" 
                                          Height="16"/>
                                </Border>
                                <TextBlock Text="带自定义图标的选项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        
                        <CheckBox Margin="0,10,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="24" Height="24" Margin="0,0,8,0">
                                    <Rectangle.Fill>
                                        <DrawingBrush>
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF4CAF50" Geometry="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,17V16H9V14H13V13H10A1,1 0 0,1 9,12V9A1,1 0 0,1 10,8H11V7H13V8H15V10H11V11H14A1,1 0 0,1 15,12V15A1,1 0 0,1 14,16H13V17H11Z"/>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="高级支付选项" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="4. 交互式内容" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        在CheckBox中添加可交互的元素。注意：CheckBox内部的控件点击会触发CheckBox的点击事件。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox x:Name="interactiveCheckBox" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="复选框带提示" VerticalAlignment="Center"/>
                                <Button Content="?" 
                                        Margin="5,0,0,0" 
                                        Width="20" Height="20" 
                                        Padding="0"
                                        Click="HelpButton_Click"/>
                            </StackPanel>
                        </CheckBox>
                        
                        <TextBlock x:Name="helpText" 
                                   Visibility="Collapsed"
                                   Margin="20,5,0,0" 
                                   Foreground="Gray" 
                                   TextWrapping="Wrap">
                            这是一个帮助提示，说明此选项的用途。点击问号按钮可以切换显示此内容。
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 