<Page
    x:Class="WPF_CheckBox.Pages.CustomContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="自定义内容"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="CheckBox自定义内容" />

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="1. 基本文本内容" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        除了简单的字符串外，Content属性还可以设置复杂的内容。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5">
                            <TextBlock Text="使用TextBlock作为内容" TextWrapping="Wrap" />
                        </CheckBox>

                        <CheckBox Margin="0,10,0,5">
                            <TextBlock>
                                <Run FontWeight="Bold" Text="带" />
                                <Run Foreground="Blue" Text="格式化" />
                                <Run FontStyle="Italic" Text="的文本" />
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="2. 内嵌布局和控件" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        CheckBox的内容可以包含复杂的布局和多个控件。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,5,0"
                                    Fill="Red" />
                                <TextBlock Text="带图形的选项" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Margin="0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,5,0"
                                    FontWeight="Bold"
                                    Text="标题：" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="带网格布局的复选框" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,3,0,0"
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="可以包含多行内容和更复杂的布局" />
                            </Grid>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="3. 带图像的复选框" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        在CheckBox中使用图像和图标。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Margin="0,0,8,0"
                                    Padding="3"
                                    Background="#e1f5fe"
                                    BorderBrush="#81d4fa"
                                    BorderThickness="1">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M9,20.42L2.79,14.21L5.62,11.38L9,14.77L18.88,4.88L21.71,7.71L9,20.42Z"
                                        Fill="#0288d1"
                                        Stretch="Uniform" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="带自定义图标的选项" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Margin="0,10,0,5">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,8,0">
                                    <Rectangle.Fill>
                                        <DrawingBrush>
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF4CAF50" Geometry="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,17V16H9V14H13V13H10A1,1 0 0,1 9,12V9A1,1 0 0,1 10,8H11V7H13V8H15V10H11V11H14A1,1 0 0,1 15,12V15A1,1 0 0,1 14,16H13V17H11Z" />
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock VerticalAlignment="Center" Text="高级支付选项" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="4. 交互式内容" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        在CheckBox中添加可交互的元素。注意：CheckBox内部的控件点击会触发CheckBox的点击事件。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox x:Name="interactiveCheckBox" Margin="0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="复选框带提示" />
                                <Button
                                    Width="20"
                                    Height="20"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Click="HelpButton_Click"
                                    Content="?" />
                            </StackPanel>
                        </CheckBox>

                        <TextBlock
                            x:Name="helpText"
                            Margin="20,5,0,0"
                            Foreground="Gray"
                            TextWrapping="Wrap"
                            Visibility="Collapsed">
                            这是一个帮助提示，说明此选项的用途。点击问号按钮可以切换显示此内容。
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 