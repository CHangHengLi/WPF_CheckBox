<Page
    x:Class="WPF_CheckBox.Pages.BasicUsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="基本用法"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="CheckBox基本用法" />

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="1. 基本属性" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        下面展示了CheckBox的基本用法，包括内容设置、默认状态和禁用状态。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5" Content="默认复选框" />
                        <CheckBox
                            Margin="0,5"
                            Content="默认选中状态"
                            IsChecked="True" />
                        <CheckBox
                            Margin="0,5"
                            Content="禁用状态"
                            IsEnabled="False" />
                        <CheckBox
                            Margin="0,5"
                            Content="禁用且选中状态"
                            IsChecked="True"
                            IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="2. 事件处理" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        演示CheckBox的Checked和Unchecked事件。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            x:Name="eventCheckBox"
                            Margin="0,5"
                            Checked="EventCheckBox_Checked"
                            Content="点击我触发事件"
                            Unchecked="EventCheckBox_Unchecked" />

                        <TextBlock
                            x:Name="eventResult"
                            Margin="0,10,0,0"
                            Foreground="Blue" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="3. 对齐方式" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        演示不同的内容对齐方式。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5" Content="默认对齐" />
                        <CheckBox
                            Margin="0,5"
                            HorizontalContentAlignment="Left"
                            Content="左对齐" />
                        <CheckBox
                            Margin="0,5"
                            HorizontalContentAlignment="Center"
                            Content="居中对齐" />
                        <CheckBox
                            Margin="0,5"
                            HorizontalContentAlignment="Right"
                            Content="右对齐" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="4. 外观设置" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        演示修改CheckBox的前景色、背景色和字体设置。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox Margin="0,5" Content="默认外观" />
                        <CheckBox
                            Margin="0,5"
                            Content="蓝色前景"
                            Foreground="Blue" />
                        <CheckBox
                            Margin="0,5"
                            Background="LightYellow"
                            BorderBrush="Orange"
                            BorderThickness="1"
                            Content="带背景色" />
                        <CheckBox
                            Margin="0,5"
                            Content="加粗字体"
                            FontWeight="Bold" />
                        <CheckBox
                            Margin="0,5"
                            Content="增大字体"
                            FontSize="16" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 