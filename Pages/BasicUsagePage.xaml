<Page x:Class="WPF_CheckBox.Pages.BasicUsagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_CheckBox.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="基本用法">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="CheckBox基本用法" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. 基本属性" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        下面展示了CheckBox的基本用法，包括内容设置、默认状态和禁用状态。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="默认复选框" Margin="0,5"/>
                        <CheckBox Content="默认选中状态" IsChecked="True" Margin="0,5"/>
                        <CheckBox Content="禁用状态" IsEnabled="False" Margin="0,5"/>
                        <CheckBox Content="禁用且选中状态" IsEnabled="False" IsChecked="True" Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. 事件处理" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        演示CheckBox的Checked和Unchecked事件。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox x:Name="eventCheckBox" 
                                  Content="点击我触发事件" 
                                  Checked="EventCheckBox_Checked" 
                                  Unchecked="EventCheckBox_Unchecked"
                                  Margin="0,5"/>
                        
                        <TextBlock x:Name="eventResult" 
                                   Margin="0,10,0,0" 
                                   Foreground="Blue"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="3. 对齐方式" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        演示不同的内容对齐方式。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="默认对齐" Margin="0,5"/>
                        <CheckBox Content="左对齐" 
                                  HorizontalContentAlignment="Left" 
                                  Margin="0,5"/>
                        <CheckBox Content="居中对齐" 
                                  HorizontalContentAlignment="Center" 
                                  Margin="0,5"/>
                        <CheckBox Content="右对齐" 
                                  HorizontalContentAlignment="Right" 
                                  Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="4. 外观设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        演示修改CheckBox的前景色、背景色和字体设置。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="默认外观" Margin="0,5"/>
                        <CheckBox Content="蓝色前景" 
                                  Foreground="Blue" 
                                  Margin="0,5"/>
                        <CheckBox Content="带背景色" 
                                  Background="LightYellow" 
                                  BorderBrush="Orange"
                                  BorderThickness="1"
                                  Margin="0,5"/>
                        <CheckBox Content="加粗字体" 
                                  FontWeight="Bold" 
                                  Margin="0,5"/>
                        <CheckBox Content="增大字体" 
                                  FontSize="16" 
                                  Margin="0,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 