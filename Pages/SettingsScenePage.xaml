<Page x:Class="WPF_CheckBox.Pages.SettingsScenePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_CheckBox.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="设置页面">

    <Grid>
        <Grid.Resources>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>
            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,15,0,0"/>
                <Setter Property="Padding" Value="8,12,8,8"/>
            </Style>
            <Style TargetType="TextBlock" x:Key="CategoryHeader">
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,10,0,8"/>
            </Style>
        </Grid.Resources>
        
        <ScrollViewer>
            <StackPanel Margin="20" MaxWidth="700" HorizontalAlignment="Left">
                <TextBlock Text="应用程序设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <Border Background="#f0f0f0" Padding="15" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="通用设置" Style="{StaticResource CategoryHeader}"/>
                        
                        <CheckBox Content="开机自动启动应用程序" x:Name="autoStartCheckBox"/>
                        <TextBlock Text="允许应用程序在系统启动时自动运行" 
                                   Margin="24,2,0,0" Foreground="#666" FontSize="12"/>
                        
                        <CheckBox Content="自动检查更新" x:Name="autoUpdateCheckBox" IsChecked="True"/>
                        <CheckBox Content="后台运行" x:Name="runInBackgroundCheckBox"/>
                        <CheckBox Content="最小化到系统托盘" x:Name="minimizeToTrayCheckBox"/>
                        
                        <TextBlock Text="启动设置" Style="{StaticResource CategoryHeader}"/>
                        
                        <CheckBox Content="启动时显示欢迎画面" x:Name="showWelcomeCheckBox" IsChecked="True"/>
                        <CheckBox Content="启动时恢复上次会话" x:Name="restoreSessionCheckBox"/>
                    </StackPanel>
                </Border>
                
                <GroupBox Header="界面设置">
                    <StackPanel>
                        <CheckBox Content="显示状态栏" IsChecked="True" x:Name="showStatusBarCheckBox"/>
                        <CheckBox Content="显示工具栏" IsChecked="True" x:Name="showToolbarCheckBox"/>
                        <CheckBox Content="使用深色主题" Checked="DarkTheme_CheckChanged" Unchecked="DarkTheme_CheckChanged" x:Name="darkThemeCheckBox"/>
                        <CheckBox Content="在文件资源管理器中显示预览" x:Name="showPreviewCheckBox"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="编辑功能">
                    <StackPanel>
                        <CheckBox Content="自动保存更改" x:Name="autoSaveCheckBox"/>
                        <StackPanel Margin="24,5,0,0" x:Name="autoSaveOptions" IsEnabled="{Binding IsChecked, ElementName=autoSaveCheckBox}">
                            <CheckBox Content="每10分钟保存" x:Name="save10MinCheckBox" IsChecked="True"/>
                            <CheckBox Content="在后台保存" x:Name="saveBackgroundCheckBox"/>
                            <CheckBox Content="创建备份文件" x:Name="createBackupCheckBox"/>
                        </StackPanel>
                        
                        <CheckBox Content="拼写检查" Margin="0,10,0,0" x:Name="spellCheckCheckBox" IsChecked="True"/>
                        <CheckBox Content="自动完成" x:Name="autoCompleteCheckBox" IsChecked="True"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="通知设置">
                    <StackPanel>
                        <CheckBox Content="接收所有通知" IsChecked="True" x:Name="allNotificationsCheckBox" 
                                  Checked="AllNotifications_CheckChanged" 
                                  Unchecked="AllNotifications_CheckChanged"/>
                        
                        <StackPanel Margin="24,5,0,0" x:Name="notificationOptions" 
                                    IsEnabled="{Binding IsChecked, ElementName=allNotificationsCheckBox}">
                            <CheckBox Content="消息通知" x:Name="messageNotificationsCheckBox" IsChecked="True"/>
                            <CheckBox Content="更新通知" x:Name="updateNotificationsCheckBox" IsChecked="True"/>
                            <CheckBox Content="系统通知" x:Name="systemNotificationsCheckBox" IsChecked="True"/>
                        </StackPanel>
                        
                        <CheckBox Content="通知声音" Margin="0,10,0,0" x:Name="notificationSoundCheckBox" IsChecked="True"
                                  IsEnabled="{Binding IsChecked, ElementName=allNotificationsCheckBox}"/>
                    </StackPanel>
                </GroupBox>
                
                <StackPanel Orientation="Horizontal" Margin="0,25,0,0" HorizontalAlignment="Right">
                    <Button Content="恢复默认设置" Width="120" Margin="0,0,10,0" Click="ResetDefaults_Click"/>
                    <Button Content="保存设置" Width="120" Background="#1976D2" Foreground="White" Click="SaveSettings_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 