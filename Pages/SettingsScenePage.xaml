<Page
    x:Class="WPF_CheckBox.Pages.SettingsScenePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="设置页面"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,15,0,0" />
                <Setter Property="Padding" Value="8,12,8,8" />
            </Style>
            <Style x:Key="CategoryHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,10,0,8" />
            </Style>
        </Grid.Resources>

        <ScrollViewer>
            <StackPanel
                MaxWidth="700"
                Margin="20"
                HorizontalAlignment="Left">
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="应用程序设置" />

                <Border
                    Padding="15"
                    Background="#f0f0f0"
                    CornerRadius="5">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CategoryHeader}" Text="通用设置" />

                        <CheckBox x:Name="autoStartCheckBox" Content="开机自动启动应用程序" />
                        <TextBlock
                            Margin="24,2,0,0"
                            FontSize="12"
                            Foreground="#666"
                            Text="允许应用程序在系统启动时自动运行" />

                        <CheckBox
                            x:Name="autoUpdateCheckBox"
                            Content="自动检查更新"
                            IsChecked="True" />
                        <CheckBox x:Name="runInBackgroundCheckBox" Content="后台运行" />
                        <CheckBox x:Name="minimizeToTrayCheckBox" Content="最小化到系统托盘" />

                        <TextBlock Style="{StaticResource CategoryHeader}" Text="启动设置" />

                        <CheckBox
                            x:Name="showWelcomeCheckBox"
                            Content="启动时显示欢迎画面"
                            IsChecked="True" />
                        <CheckBox x:Name="restoreSessionCheckBox" Content="启动时恢复上次会话" />
                    </StackPanel>
                </Border>

                <GroupBox Header="界面设置">
                    <StackPanel>
                        <CheckBox
                            x:Name="showStatusBarCheckBox"
                            Content="显示状态栏"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="showToolbarCheckBox"
                            Content="显示工具栏"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="darkThemeCheckBox"
                            Checked="DarkTheme_CheckChanged"
                            Content="使用深色主题"
                            Unchecked="DarkTheme_CheckChanged" />
                        <CheckBox x:Name="showPreviewCheckBox" Content="在文件资源管理器中显示预览" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="编辑功能">
                    <StackPanel>
                        <CheckBox x:Name="autoSaveCheckBox" Content="自动保存更改" />
                        <StackPanel
                            x:Name="autoSaveOptions"
                            Margin="24,5,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=autoSaveCheckBox}">
                            <CheckBox
                                x:Name="save10MinCheckBox"
                                Content="每10分钟保存"
                                IsChecked="True" />
                            <CheckBox x:Name="saveBackgroundCheckBox" Content="在后台保存" />
                            <CheckBox x:Name="createBackupCheckBox" Content="创建备份文件" />
                        </StackPanel>

                        <CheckBox
                            x:Name="spellCheckCheckBox"
                            Margin="0,10,0,0"
                            Content="拼写检查"
                            IsChecked="True" />
                        <CheckBox
                            x:Name="autoCompleteCheckBox"
                            Content="自动完成"
                            IsChecked="True" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="通知设置">
                    <StackPanel>
                        <CheckBox
                            x:Name="allNotificationsCheckBox"
                            Checked="AllNotifications_CheckChanged"
                            Content="接收所有通知"
                            IsChecked="True"
                            Unchecked="AllNotifications_CheckChanged" />

                        <StackPanel
                            x:Name="notificationOptions"
                            Margin="24,5,0,0"
                            IsEnabled="{Binding IsChecked, ElementName=allNotificationsCheckBox}">
                            <CheckBox
                                x:Name="messageNotificationsCheckBox"
                                Content="消息通知"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="updateNotificationsCheckBox"
                                Content="更新通知"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="systemNotificationsCheckBox"
                                Content="系统通知"
                                IsChecked="True" />
                        </StackPanel>

                        <CheckBox
                            x:Name="notificationSoundCheckBox"
                            Margin="0,10,0,0"
                            Content="通知声音"
                            IsChecked="True"
                            IsEnabled="{Binding IsChecked, ElementName=allNotificationsCheckBox}" />
                    </StackPanel>
                </GroupBox>

                <StackPanel
                    Margin="0,25,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="120"
                        Margin="0,0,10,0"
                        Click="ResetDefaults_Click"
                        Content="恢复默认设置" />
                    <Button
                        Width="120"
                        Background="#1976D2"
                        Click="SaveSettings_Click"
                        Content="保存设置"
                        Foreground="White" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page> 