<Page
    x:Class="WPF_CheckBox.Pages.FilterScenePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="数据筛选"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  筛选面板  -->
        <Border
            Grid.Column="0"
            Background="#f8f8f8"
            BorderBrush="#ddd"
            BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock
                        Margin="0,0,0,15"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="筛选条件" />

                    <Expander
                        Margin="0,0,0,10"
                        Header="商品类别"
                        IsExpanded="True">
                        <StackPanel Margin="15,10,0,0">
                            <CheckBox
                                x:Name="electronicsCategory"
                                Checked="Filter_Changed"
                                Content="电子产品"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="homeCategory"
                                Checked="Filter_Changed"
                                Content="家居用品"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="kitchenCategory"
                                Checked="Filter_Changed"
                                Content="厨房用具"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="officeCategory"
                                Checked="Filter_Changed"
                                Content="办公用品"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="outdoorCategory"
                                Checked="Filter_Changed"
                                Content="户外装备"
                                Unchecked="Filter_Changed" />
                        </StackPanel>
                    </Expander>

                    <Expander
                        Margin="0,0,0,10"
                        Header="价格区间"
                        IsExpanded="True">
                        <StackPanel Margin="15,10,0,0">
                            <CheckBox
                                x:Name="price0to100"
                                Checked="Filter_Changed"
                                Content="¥0 - ¥100"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="price100to500"
                                Checked="Filter_Changed"
                                Content="¥100 - ¥500"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="price500to1000"
                                Checked="Filter_Changed"
                                Content="¥500 - ¥1000"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="priceOver1000"
                                Checked="Filter_Changed"
                                Content="¥1000以上"
                                Unchecked="Filter_Changed" />
                        </StackPanel>
                    </Expander>

                    <Expander
                        Margin="0,0,0,10"
                        Header="用户评分"
                        IsExpanded="True">
                        <StackPanel Margin="15,10,0,0">
                            <CheckBox
                                x:Name="rating5"
                                Checked="Filter_Changed"
                                Content="5星"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="rating4"
                                Checked="Filter_Changed"
                                Content="4星"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="rating3"
                                Checked="Filter_Changed"
                                Content="3星"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="ratingBelow2"
                                Checked="Filter_Changed"
                                Content="2星以下"
                                Unchecked="Filter_Changed" />
                        </StackPanel>
                    </Expander>

                    <Expander
                        Margin="0,0,0,10"
                        Header="其他选项"
                        IsExpanded="True">
                        <StackPanel Margin="15,10,0,0">
                            <CheckBox
                                x:Name="inStock"
                                Checked="Filter_Changed"
                                Content="有货"
                                IsChecked="True"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="onSale"
                                Checked="Filter_Changed"
                                Content="促销商品"
                                Unchecked="Filter_Changed" />
                            <CheckBox
                                x:Name="freeShipping"
                                Checked="Filter_Changed"
                                Content="免运费"
                                Unchecked="Filter_Changed" />
                        </StackPanel>
                    </Expander>

                    <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Padding="10,5"
                            Click="ResetFilter_Click"
                            Content="重置筛选" />
                        <Button
                            Padding="10,5"
                            Background="#2196F3"
                            Click="ApplyFilter_Click"
                            Content="应用筛选"
                            Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  产品列表  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部操作栏  -->
            <Border
                Grid.Row="0"
                Padding="20,15"
                Background="White"
                BorderBrush="#ddd"
                BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock
                        x:Name="resultCount"
                        VerticalAlignment="Center"
                        Text="显示0个结果" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="排序方式：" />
                        <ComboBox
                            x:Name="sortingComboBox"
                            Width="120"
                            Margin="5,0,0,0"
                            SelectedIndex="0"
                            SelectionChanged="SortingComboBox_SelectionChanged">
                            <ComboBoxItem Content="默认排序" />
                            <ComboBoxItem Content="价格从低到高" />
                            <ComboBoxItem Content="价格从高到低" />
                            <ComboBoxItem Content="评分从高到低" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  产品网格  -->
            <ScrollViewer Grid.Row="1" Padding="10">
                <WrapPanel x:Name="productsPanel">
                    <!--  产品项在后台代码中动态添加  -->
                </WrapPanel>
            </ScrollViewer>

            <!--  无结果提示  -->
            <TextBlock
                x:Name="noResultsText"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="#666"
                Text="没有符合筛选条件的商品"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page> 