<Page
    x:Class="WPF_CheckBox.Pages.DataBindingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WPF_CheckBox.ViewModels"
    Title="数据绑定"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:DataBindingViewModel />
    </Page.DataContext>

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="CheckBox数据绑定" />

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="1. 简单绑定" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        将CheckBox的IsChecked属性绑定到ViewModel的属性。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            Margin="0,5"
                            Content="接收新闻订阅邮件"
                            IsChecked="{Binding ReceiveNewsletter, Mode=TwoWay}" />

                        <Border
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="#f8f8f8">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" Text="当前状态：" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="Green"
                                    Text="已订阅"
                                    Visibility="{Binding ReceiveNewsletter, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="2. 集合绑定" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        使用ItemsControl绑定CheckBox集合，通常用于设置或多选场景。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <TextBlock
                            Margin="0,0,0,5"
                            FontWeight="SemiBold"
                            Text="可用功能：" />

                        <ItemsControl ItemsSource="{Binding FeatureList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="0,3"
                                        Content="{Binding Name}"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border
                            Margin="0,15,0,0"
                            Padding="10"
                            Background="#f8f8f8">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontWeight="SemiBold"
                                    Text="已启用功能：" />
                                <ItemsControl ItemsSource="{Binding FeatureList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,2"
                                                    Text="{Binding Name}"
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="3. 命令绑定" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        使用命令模式响应CheckBox的状态变化。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            x:Name="advancedFeatureCheckBox"
                            Margin="0,5"
                            Checked="AdvancedFeature_CheckChanged"
                            Content="启用高级功能"
                            Unchecked="AdvancedFeature_CheckChanged" />

                        <StackPanel
                            x:Name="advancedPanel"
                            Margin="20,10,0,0"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontWeight="SemiBold"
                                Text="高级设置" />
                            <Slider
                                Width="200"
                                Margin="0,5"
                                HorizontalAlignment="Left" />
                            <TextBox
                                Width="200"
                                Margin="0,5"
                                HorizontalAlignment="Left"
                                Text="高级参数配置" />
                            <Button
                                Width="120"
                                Margin="0,5"
                                HorizontalAlignment="Left"
                                Content="应用高级设置" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="4. 高级绑定" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        使用转换器和触发器。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            x:Name="detailsCheckBox"
                            Margin="0,5"
                            Content="显示详细信息" />

                        <Border
                            Margin="0,10,0,0"
                            Padding="10"
                            BorderBrush="#ddd"
                            BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="基本信息" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Text="详细信息"
                                    Visibility="{Binding IsChecked, ElementName=detailsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel Margin="15,5,0,0" Visibility="{Binding IsChecked, ElementName=detailsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="- 详细说明1" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="- 详细说明2" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="- 详细说明3" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 