<Page x:Class="WPF_CheckBox.Pages.DataBindingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPF_CheckBox.Pages"
      xmlns:vm="clr-namespace:WPF_CheckBox.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="数据绑定">

    <Page.DataContext>
        <vm:DataBindingViewModel/>
    </Page.DataContext>
    
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="CheckBox数据绑定" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="1. 简单绑定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        将CheckBox的IsChecked属性绑定到ViewModel的属性。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="接收新闻订阅邮件" 
                                  IsChecked="{Binding ReceiveNewsletter, Mode=TwoWay}" 
                                  Margin="0,5"/>
                        
                        <Border Background="#f8f8f8" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="当前状态：" Margin="0,0,0,5"/>
                                <TextBlock Text="已订阅" 
                                           FontWeight="Bold" Foreground="Green" 
                                           Visibility="{Binding ReceiveNewsletter, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="2. 集合绑定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        使用ItemsControl绑定CheckBox集合，通常用于设置或多选场景。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <TextBlock Text="可用功能：" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        
                        <ItemsControl ItemsSource="{Binding FeatureList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" 
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              Margin="0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <Border Background="#f8f8f8" Padding="10" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="已启用功能：" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding FeatureList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock 
                                                    Text="{Binding Name}" 
                                                    Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Margin="0,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="3. 命令绑定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        使用命令模式响应CheckBox的状态变化。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="启用高级功能" 
                                  x:Name="advancedFeatureCheckBox"
                                  Checked="AdvancedFeature_CheckChanged"
                                  Unchecked="AdvancedFeature_CheckChanged"
                                  Margin="0,5"/>
                        
                        <StackPanel x:Name="advancedPanel" Visibility="Collapsed" Margin="20,10,0,0">
                            <TextBlock Text="高级设置" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Slider Width="200" HorizontalAlignment="Left" Margin="0,5"/>
                            <TextBox Text="高级参数配置" Width="200" HorizontalAlignment="Left" Margin="0,5"/>
                            <Button Content="应用高级设置" Width="120" HorizontalAlignment="Left" Margin="0,5"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <Border BorderBrush="#ddd" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="4. 高级绑定" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        使用转换器和触发器。
                    </TextBlock>
                    
                    <StackPanel Margin="10">
                        <CheckBox Content="显示详细信息" 
                                  x:Name="detailsCheckBox"
                                  Margin="0,5"/>
                        
                        <Border BorderBrush="#ddd" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="基本信息"/>
                                <TextBlock Text="详细信息"
                                       Margin="0,5,0,0"
                                       Visibility="{Binding IsChecked, ElementName=detailsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Margin="15,5,0,0"
                                        Visibility="{Binding IsChecked, ElementName=detailsCheckBox, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="- 详细说明1" Foreground="Gray" FontSize="12"/>
                                    <TextBlock Text="- 详细说明2" Foreground="Gray" FontSize="12"/>
                                    <TextBlock Text="- 详细说明3" Foreground="Gray" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 