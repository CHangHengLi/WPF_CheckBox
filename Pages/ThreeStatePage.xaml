<Page
    x:Class="WPF_CheckBox.Pages.ThreeStatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPF_CheckBox.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="三态CheckBox"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="AliceBlue"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock
                Margin="0,0,0,20"
                FontSize="24"
                FontWeight="Bold"
                Text="三态CheckBox" />

            <Border
                Margin="0,0,0,20"
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="1. 三态基本用法" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        通过设置IsThreeState属性为true，可以让CheckBox支持三种状态：选中(true)、取消选中(false)和不确定(null)。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            x:Name="threeStateCheckBox"
                            Margin="0,5"
                            Checked="ThreeState_StateChanged"
                            Content="三态复选框"
                            Indeterminate="ThreeState_StateChanged"
                            IsThreeState="True"
                            Unchecked="ThreeState_StateChanged" />

                        <StackPanel Margin="0,10" Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Click="SetChecked_Click"
                                Content="设为选中" />
                            <Button
                                Margin="0,0,5,0"
                                Click="SetUnchecked_Click"
                                Content="设为未选中" />
                            <Button Click="SetIndeterminate_Click" Content="设为不确定" />
                        </StackPanel>

                        <TextBlock x:Name="stateText" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Padding="15"
                BorderBrush="#ddd"
                BorderThickness="1">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="2. 全选功能应用" />
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap">
                        三态CheckBox常用于"全选"功能，当子项全部选中时为选中状态，全部未选中时为未选中状态，部分选中时为不确定状态。
                    </TextBlock>

                    <StackPanel Margin="10">
                        <CheckBox
                            x:Name="parentCheckBox"
                            Margin="0,5"
                            Click="ParentCheckBox_CheckChanged"
                            Content="全选"
                            IsThreeState="True" />

                        <StackPanel Margin="20,5,0,0">
                            <CheckBox
                                x:Name="childCheckBox1"
                                Margin="0,5"
                                Checked="ChildCheckBox_CheckChanged"
                                Content="子选项1"
                                Unchecked="ChildCheckBox_CheckChanged" />
                            <CheckBox
                                x:Name="childCheckBox2"
                                Margin="0,5"
                                Checked="ChildCheckBox_CheckChanged"
                                Content="子选项2"
                                Unchecked="ChildCheckBox_CheckChanged" />
                            <CheckBox
                                x:Name="childCheckBox3"
                                Margin="0,5"
                                Checked="ChildCheckBox_CheckChanged"
                                Content="子选项3"
                                Unchecked="ChildCheckBox_CheckChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page> 