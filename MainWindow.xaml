<Window x:Class="WPF_CheckBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_CheckBox"
        mc:Ignorable="d"
        Title="WPF CheckBox演示程序" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2c3e50">
            <TextBlock
                Margin="15,10"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="CheckBox控件详解演示" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航菜单 -->
            <Border
                Background="#f5f5f5"
                BorderBrush="#ddd"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="5">
                        <TextBlock Text="基本功能" 
                                   FontWeight="Bold" 
                                   Margin="10,15,10,5"/>
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="BasicUsage_Click"
                            Content="基本用法" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="ThreeState_Click"
                            Content="三态CheckBox" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="CustomContent_Click"
                            Content="自定义内容" />
                        
                        <TextBlock Text="高级功能" 
                                   FontWeight="Bold" 
                                   Margin="10,15,10,5"/>
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="DataBinding_Click"
                            Content="数据绑定" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="Styles_Click"
                            Content="自定义样式" />
                        
                        <TextBlock Text="应用场景" 
                                   FontWeight="Bold" 
                                   Margin="10,15,10,5"/>
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="SettingsScene_Click"
                            Content="设置页面" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="PermissionsScene_Click"
                            Content="权限选择" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="FilterScene_Click"
                            Content="数据筛选" />
                        
                        <Button
                            Margin="5"
                            Padding="10,5"
                            HorizontalContentAlignment="Left"
                            Click="BestPractices_Click"
                            Content="最佳实践" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右侧内容区域 -->
            <Frame
                x:Name="MainContent"
                Grid.Column="1"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Window>
